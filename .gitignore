/target

# what a local run of the agent leaves in the working directory: the settings its harness writes,
# and the sandbox's scratch directory when a confined command was killed before it could be tidied
.claude/settings.local.json
kamchatka-*/

# what `cargo run --example recorded` writes: whole sessions, regenerated on demand
recorded/

# rustfmt's backups and the counters a profiled run drops
**/*.rs.bk
*.profraw

# editors and desktops
.DS_Store
*.swp
*~
